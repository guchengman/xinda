---
import Layout from '../layouts/Layout.astro';
import { COMPANY, PHILOSOPHY, TIMELINE, BRANCHES } from '../consts/company';
---

<Layout title="关于我们 — 新大物流">
  <!-- Hero -->
  <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">关于我们</h1>
      <p class="text-white/70 text-sm md:text-lg max-w-2xl mx-auto">深耕赣粤专线十五载，以诚信和专业赢得客户信赖</p>
    </div>
  </section>

  <!-- 公司简介 -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <div>
          <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-6">{COMPANY.name}</h2>
          <div class="space-y-4 text-surface-600 text-sm md:text-base leading-relaxed">
            <p>我公司从事货运业务已有近二十年之久，专门经营赣州和广东两地货物运输。我公司实力雄厚，经验丰富。佛山、广州、顺德、中山都设有分公司，赣州贸易广场和建材大市场分别设有分公司，公司有八部大型新货车、社会合约大型货车有一百多部，每天往返赣州、广州、佛山、顺德、中山五地，广东各分公司都有接货车，赣州分公司各有两部小货车和两部电瓶车送货、接货，公司能做到货物快运，今天托运，明天能到，当天送货。</p>
            <p>公司有员工八十多人，公司领导都有较高的文化，有一班训练有素的工作队伍。他们的工作认真，踏实，讲信用，讲服务，运价不高，能做到安全可靠，服务周到，上下员工努力奋斗，一定要把新大物流公司办成一个先进的现代化的品牌物流公司。</p>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-brand-100 to-brand-50 flex items-center justify-center p-8 md:p-12">
            <div class="text-center">
              <div class="text-6xl md:text-8xl font-bold text-brand-600 mb-2">{COMPANY.name}</div>
              <p class="text-brand-700 text-sm md:text-base">"{COMPANY.slogan}"</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 企业文化 -->
  <section class="py-14 md:py-20 bg-surface-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">企业文化</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white rounded-2xl p-6 md:p-8 text-center shadow-sm border border-surface-100">
          <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-800 mb-2">企业使命</h3>
          <p class="text-sm text-surface-500">{PHILOSOPHY.mission}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 md:p-8 text-center shadow-sm border border-surface-100">
          <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-800 mb-2">企业愿景</h3>
          <p class="text-sm text-surface-500">{PHILOSOPHY.vision}</p>
        </div>
        <div class="bg-white rounded-2xl p-6 md:p-8 text-center shadow-sm border border-surface-100">
          <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-800 mb-2">核心价值观</h3>
          <p class="text-sm text-surface-500">{PHILOSOPHY.value}</p>
        </div>
      </div>
      <!-- 品牌格言 -->
      <div class="mt-10 text-center p-8 md:p-10 bg-white rounded-2xl border border-surface-100 shadow-sm">
        <p class="text-surface-400 text-sm mb-2">品牌格言</p>
        <p class="text-xl md:text-3xl font-bold text-brand-600">"{PHILOSOPHY.motto}"</p>
      </div>
    </div>
  </section>

  <!-- 发展历程 -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">发展历程</h2>
        <p class="text-surface-500 text-sm md:text-base">一步一个脚印，稳步发展壮大</p>
      </div>
      <div class="relative">
        <!-- 中间时间线 -->
        <div class="absolute left-[19px] md:left-1/2 top-0 bottom-0 w-0.5 bg-brand-200 -translate-x-1/2"></div>
        {TIMELINE.map((item, i) => (
          <div class={`relative flex items-start gap-6 md:gap-0 mb-8 md:mb-12 last:mb-0 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            {/* 时间点圆点 */}
            <div class="relative z-10 shrink-0 w-10 h-10 rounded-full bg-brand-600 border-4 border-white shadow flex items-center justify-center md:absolute md:left-1/2 md:-translate-x-1/2">
              <div class="w-2 h-2 rounded-full bg-white"></div>
            </div>
            {/* 内容卡片 */}
            <div class={`flex-1 md:w-1/2 ${i % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12'}`}>
              <div class="bg-surface-50 rounded-xl p-4 md:p-6">
                <span class="text-brand-600 font-bold text-sm md:text-base">{item.year}</span>
                <p class="text-surface-700 text-sm md:text-base mt-1">{item.event}</p>
              </div>
            </div>
            <div class="hidden md:block md:w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 网点分布 -->
  <section class="py-14 md:py-20 bg-surface-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">网点分布</h2>
        <p class="text-surface-500 text-sm md:text-base">六地直营网点，覆盖赣粤核心区域</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {BRANCHES.map((branch) => (
          <a
            href={`tel:${branch.phone}`}
            class="bg-white rounded-xl p-5 md:p-6 border border-surface-100 hover:border-brand-200 hover:shadow-md transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 font-bold text-sm group-hover:bg-brand-600 group-hover:text-white transition-colors">
                {branch.city.charAt(0)}
              </div>
              <h3 class="font-semibold text-surface-800">{branch.city}</h3>
            </div>
            <p class="text-xs md:text-sm text-surface-500 mb-2 leading-relaxed">{branch.address}</p>
            <div class="flex items-center gap-2 text-brand-600 font-semibold text-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {branch.phone}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 md:py-20 bg-brand-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-4xl font-bold text-white mb-4">期待与您的合作</h2>
      <p class="text-white/80 text-sm md:text-lg mb-8">欢迎来电咨询，我们将竭诚为您服务</p>
      <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white text-brand-600 font-bold text-base md:text-lg rounded-xl hover:bg-surface-50 transition-all shadow-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {COMPANY.hotline}
      </a>
    </div>
  </section>
</Layout>
