---
import Layout from '../layouts/Layout.astro';
import { SERVICES, VALUE_ADDED_SERVICES, COMPANY } from '../consts/company';
---

<Layout title="赣州到广东物流专线 — 整车·零担·仓储·家具运输 — 新大物流" description="新大物流提供赣州至广东（广州、佛山、中山、顺德）往返整车运输、零担配送、仓储服务及南康家具运输专线，自有车队天天发车，今天发货明天到达。">
  <!-- Hero -->
  <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">服务范围</h1>
      <p class="text-white/70 text-sm md:text-lg max-w-2xl mx-auto">全方位物流服务，赣粤专线 · 仓储配送 · 增值服务</p>
    </div>
  </section>

  <!-- 核心服务 -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">核心业务</h2>
        <p class="text-surface-500 text-sm md:text-base max-w-2xl mx-auto">
          以赣州—广东往返专线为核心，提供整车、零担、仓储一站式物流服务
        </p>
      </div>
      <div class="space-y-10 md:space-y-16">
        {SERVICES.map((service, i) => (
          <div class={`grid md:grid-cols-2 gap-8 md:gap-14 items-center ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            <div class={`${i % 2 === 1 ? 'md:order-1' : ''}`}>
              <h3 class="text-xl md:text-3xl font-bold text-surface-800 mb-4">{service.title}</h3>
              <p class="text-surface-500 text-sm md:text-base mb-6 leading-relaxed">{service.desc}</p>
              <ul class="space-y-3">
                {service.details.map((detail) => (
                  <li class="flex items-start gap-3 text-sm md:text-base text-surface-600">
                    <svg class="w-5 h-5 text-brand-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {detail}
                  </li>
                ))}
              </ul>
            </div>
            <div class={`aspect-[4/3] rounded-2xl bg-gradient-to-br ${i === 0 ? 'from-blue-50 to-brand-50' : i === 1 ? 'from-green-50 to-brand-50' : i === 2 ? 'from-yellow-50 to-brand-50' : 'from-orange-50 to-brand-50'} flex items-center justify-center`}>
              <div class="text-center p-8">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-white/80 backdrop-blur flex items-center justify-center mx-auto mb-4 shadow-sm">
                  {i === 0 && <svg class="w-10 h-10 md:w-12 md:h-12 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>}
                  {i === 1 && <svg class="w-10 h-10 md:w-12 md:h-12 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>}
                  {i === 2 && <svg class="w-10 h-10 md:w-12 md:h-12 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>}
                  {i === 3 && <svg class="w-10 h-10 md:w-12 md:h-12 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>}
                </div>
                <p class="text-lg md:text-2xl font-bold text-surface-800">{service.title}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 服务流程 -->
  <section class="py-14 md:py-20 bg-surface-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">服务流程</h2>
        <p class="text-surface-500 text-sm md:text-base">标准作业流程，全程专业保障</p>
      </div>
      <div class="max-w-4xl mx-auto">
        {[
          { step: '01', title: '客户委托', desc: '接到客户委托后，1小时内安排人员上门取货' },
          { step: '02', title: '专业包装', desc: '严格遵照外包装图标要求进行包装、整理、加固' },
          { step: '03', title: '当天发车', desc: '所有货物按不同运输方式当天上站、当天发车' },
          { step: '04', title: '在途跟踪', desc: '全程信息反馈，到货情况、途中运行情况及时通报' },
          { step: '05', title: '到货通知', desc: '货物到站当天通知收货人，按时送货上门' },
        ].map((item) => (
          <div class="flex gap-4 md:gap-6 mb-6 last:mb-0">
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm md:text-base font-bold shrink-0">
                {item.step}
              </div>
              <div class="w-0.5 flex-1 bg-brand-200 mt-2"></div>
            </div>
            <div class="pb-6">
              <h3 class="font-semibold text-surface-800 text-base md:text-lg mb-1">{item.title}</h3>
              <p class="text-sm text-surface-500">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 增值服务 -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">增值服务</h2>
        <p class="text-surface-500 text-sm md:text-base">更多贴心服务，让您的货物运输更省心</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
        {VALUE_ADDED_SERVICES.map((item) => (
          <div class="text-center p-5 md:p-6 rounded-xl bg-surface-50 border border-surface-100 hover:border-brand-200 hover:shadow-sm transition-all">
            <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-brand-50 flex items-center justify-center mx-auto mb-3">
              <svg class="w-5 h-5 md:w-6 md:h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 class="font-semibold text-surface-800 text-sm md:text-base mb-1">{item.title}</h3>
            <p class="text-xs md:text-sm text-surface-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 服务保障 -->
  <section class="py-14 md:py-20 bg-brand-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-4xl font-bold mb-4">服务保障</h2>
        <p class="text-white/60 text-sm md:text-base">安全可靠，让您放心托付</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: '安全运输', desc: '中国太平洋保险承保，损缺货物按价赔偿' },
          { title: '准时快捷', desc: '天天发车，准时准点，今天发货明天到达' },
          { title: '全程跟踪', desc: '一对一专人跟踪，全程信息及时反馈' },
          { title: '灵活结算', desc: '支持现结、到付、月结，代收货款，异地结算' },
        ].map((item) => (
          <div class="p-6 rounded-xl bg-white/5 border border-white/10 text-center">
            <h3 class="font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-white/60 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 md:py-20 bg-brand-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-4xl font-bold text-white mb-4">需要物流服务？</h2>
      <p class="text-white/80 text-sm md:text-lg mb-8">立即致电，为您提供专业的物流解决方案</p>
      <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white text-brand-600 font-bold text-base md:text-lg rounded-xl hover:bg-surface-50 transition-all shadow-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {COMPANY.hotline}
      </a>
    </div>
  </section>

  <!-- 结构化数据：Service + BreadcrumbList + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify([{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "赣州到广东物流专线",
    "provider": {
      "@type": "LocalBusiness",
      "name": "赣州新大物流有限公司"
    },
    "areaServed": ["赣州", "南康", "广州", "佛山", "中山", "顺德"],
    "description": "赣州至广东往返整车运输、零担配送、仓储服务及南康家具专业运输，自有车队天天发车，今天发货明天到达。",
    "offers": {
      "@type": "AggregateOffer",
      "offerCount": "4",
      "offers": [
        { "@type": "Offer", "name": "整车运输", "description": "赣州↔广东往返整车运输，点对点直达，中途不中转" },
        { "@type": "Offer", "name": "零担配送", "description": "灵活高效的零担物流服务，1小时内上门取货" },
        { "@type": "Offer", "name": "仓储服务", "description": "5600㎡+专业仓库，24小时仓储中转" },
        { "@type": "Offer", "name": "家具运输", "description": "南康↔广东家具专线，专业包装、送货入户" }
      ]
    }
  }, {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://www.xinda56.cn" },
      { "@type": "ListItem", "position": 2, "name": "服务范围", "item": "https://www.xinda56.cn/services" }
    ]
  }, {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "赣州到广州物流要多久？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "新大物流赣州到广州专线当天发货、次日到达。整车运输当天装车发运，次日上午抵达广州；零担配送当天上站发车，次日到达广州分拨中心后安排派送。"
        }
      },
      {
        "@type": "Question",
        "name": "南康家具发广东有什么物流专线？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "新大物流设有南康到广东家具运输专线，覆盖广州、佛山、中山、顺德等城市，提供EPE珍珠棉专业包装、护角加固、拆装服务、送货入户一站式服务，南康家具产业集散地直提直送。"
        }
      },
      {
        "@type": "Question",
        "name": "可以上门取货吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "可以。新大物流提供1小时内上门取货服务，接到客户委托后安排人员上门提货，无需客户自行送货到网点。"
        }
      },
      {
        "@type": "Question",
        "name": "货物损坏怎么理赔？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "新大物流所有货物由中国太平洋保险承保，如运输过程中发生货物损坏，可按购买保险额度按价理赔。建议贵重货物购买足额保险。"
        }
      },
      {
        "@type": "Question",
        "name": "支持代收货款吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "支持。新大物流提供灵活的结算方式，包括现结、到付、月结，以及代收货款、异地结算服务，方便客户根据实际情况选择。"
        }
      },
      {
        "@type": "Question",
        "name": "节假日可以发货吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "可以。新大物流24小时服务，节假日照常上班，全年无休为客户提供运输服务。"
        }
      }
    ]
  }])}>
  </script>
</Layout>
