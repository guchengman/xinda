---
import Layout from '../layouts/Layout.astro';
import { COMPANY, BRANCHES } from '../consts/company';
---

<Layout title="赣州新大物流联系方式 — 6城直营网点 · 24小时服务热线" description="新大物流在赣州、南康、广州、佛山、中山、顺德均设直营网点，全国服务热线15717088088，24小时在线，提供整车运输、零担配送、仓储等全方位物流服务。">
  <!-- Hero -->
  <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">联系我们</h1>
      <p class="text-white/70 text-sm md:text-lg max-w-2xl mx-auto">期待您的来电，为您提供专业物流服务</p>
    </div>
  </section>

  <!-- 联系方式卡片 -->
  <section class="py-10 md:py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 全国热线突出显示 -->
      <div class="bg-gradient-to-r from-brand-600 to-brand-700 rounded-2xl p-6 md:p-10 text-center text-white mb-10 md:mb-14">
        <p class="text-white/70 text-sm md:text-base mb-2">全国服务热线</p>
        <a href={`tel:${COMPANY.hotline}`} class="text-3xl md:text-5xl font-bold hover:text-white/90 transition-colors block mb-4">
          {COMPANY.hotline}
        </a>
        <p class="text-white/70 text-sm md:text-base mb-6">24小时服务，节假日照常上班</p>
        <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-brand-600 font-bold text-base rounded-xl hover:bg-surface-50 transition-all shadow-lg active:scale-[0.98]">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          点击拨打
        </a>
      </div>

      <!-- 网点列表 -->
      <div class="mb-10">
        <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-6 text-center">各网点联系方式</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {BRANCHES.map((branch) => (
            <div class="border border-surface-200 rounded-xl p-5 md:p-6 hover:border-brand-300 hover:shadow-md transition-all">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600 font-bold text-sm">{branch.city.charAt(0)}</div>
                <h3 class="font-semibold text-surface-800">{branch.city}</h3>
              </div>
              <p class="text-xs md:text-sm text-surface-500 mb-3 leading-relaxed">{branch.address}</p>
              <div class="flex flex-col gap-2">
                <a href={`tel:${branch.phone}`} class="inline-flex items-center gap-2 text-brand-600 font-semibold text-sm hover:text-brand-700">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  {branch.phone}
                </a>
                <a
                  href={`https://uri.amap.com/marker?position=&name=${encodeURIComponent(branch.city + '新大物流')}&src=xinda56`}
                  target="_blank"
                  class="inline-flex items-center gap-2 text-surface-400 text-xs hover:text-brand-600 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  查看地图导航
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 在线询价表单 -->
      <div class="max-w-2xl mx-auto">
        <div class="bg-surface-50 rounded-2xl p-6 md:p-10 border border-surface-200">
          <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-2 text-center">在线询价</h2>
          <p class="text-sm text-surface-500 mb-6 text-center">填写以下信息，我们将尽快与您联系</p>
          <form id="contact-form" class="space-y-4" action="#" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-surface-700 mb-1.5">联系人 *</label>
              <input type="text" id="name" name="name" required placeholder="请输入您的姓名"
                class="w-full px-4 py-3 rounded-xl border border-surface-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all text-sm" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-surface-700 mb-1.5">手机号 *</label>
              <input type="tel" id="phone" name="phone" required placeholder="请输入您的手机号" inputmode="numeric" pattern="[0-9]*"
                class="w-full px-4 py-3 rounded-xl border border-surface-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all text-sm" />
            </div>
            <div>
              <label for="cargo" class="block text-sm font-medium text-surface-700 mb-1.5">货物描述</label>
              <input type="text" id="cargo" name="cargo" placeholder="货物类型、重量、体积等（选填）"
                class="w-full px-4 py-3 rounded-xl border border-surface-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all text-sm" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-surface-700 mb-1.5">留言</label>
              <textarea id="message" name="message" rows="3" placeholder="其他需求或备注（选填）"
                class="w-full px-4 py-3 rounded-xl border border-surface-200 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 outline-none transition-all text-sm resize-none"></textarea>
            </div>
            <button type="submit"
              class="w-full py-3.5 bg-brand-600 text-white font-bold text-base rounded-xl hover:bg-brand-700 transition-all shadow-lg shadow-brand-600/20 active:scale-[0.99]">
              提交询价
            </button>
            <p class="text-xs text-surface-400 text-center">或直接拨打 <a href={`tel:${COMPANY.hotline}`} class="text-brand-600 font-semibold">{COMPANY.hotline}</a> 立即咨询</p>
          </form>
          <div id="form-success" class="hidden text-center py-8">
            <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <h3 class="text-xl font-bold text-surface-800 mb-2">提交成功！</h3>
            <p class="text-surface-500 text-sm">我们会尽快与您联系，请保持手机畅通</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 地图区域 -->
  <section class="py-10 md:py-14 bg-surface-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-4">公司位置</h2>
      <p class="text-sm text-surface-500 mb-6">赣州经济技术开发区犹江路新大物流</p>
      <div class="aspect-[16/5] rounded-2xl bg-surface-200 overflow-hidden max-w-5xl mx-auto">
        <iframe
          src="https://uri.amap.com/marker?position=114.904181,25.831861&name=赣州经济技术开发区犹江路新大物流&src=xinda56"
          width="100%"
          height="100%"
          style="border:0; min-height: 200px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="新大物流地图位置">
        </iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('form-success');
  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // 表单验证
      if (!data.name || !data.phone) {
        alert('请填写联系人和手机号');
        return;
      }

      try {
        // 提交到 Cloudflare Worker (部署后替换为实际 Worker 地址)
        const resp = await fetch('https://contact-form.xinda56.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (!resp.ok) {
          throw new Error('提交失败');
        }

        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
      } catch (err) {
        alert('提交失败，请直接致电我们。');
      }
    });
  }
</script>
