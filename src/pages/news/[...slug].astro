---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allNews = await getCollection('news');
const otherNews = allNews
  .filter(n => n.id !== entry.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const companyInfo = await import('../../consts/company');
const hotline = companyInfo.COMPANY.hotline;
---

<Layout title={`${entry.data.title} — 新大物流`} description={entry.data.description || `${entry.data.title} — 赣州新大物流有限公司`}>
  <article>
    <!-- 文章头部 -->
    <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
        <div class="mb-4">
          {entry.data.tags?.map(tag => (
            <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/10 text-white/70 text-xs border border-white/10 mr-2">{tag}</span>
          ))}
        </div>
        <h1 class="text-2xl md:text-4xl font-bold text-white leading-tight mb-4">{entry.data.title}</h1>
        <div class="flex items-center gap-4 text-white/50 text-xs md:text-sm">
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>{entry.data.author}</span>
        </div>
      </div>
    </section>

    <!-- 文章内容 -->
    <section class="py-10 md:py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-sm md:prose-base max-w-none prose-headings:text-surface-800 prose-headings:font-bold prose-a:text-brand-600 prose-p:text-surface-600 prose-li:text-surface-600 prose-strong:text-surface-800">
          <Content />
        </div>

        <!-- 分享和导航 -->
        <div class="mt-12 pt-8 border-t border-surface-200">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <a href="/news" class="inline-flex items-center gap-2 text-sm text-surface-500 hover:text-brand-600 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
              返回新闻列表
            </a>
            <a href={`tel:${hotline}`} class="inline-flex items-center gap-2 text-sm text-brand-600 font-semibold hover:text-brand-700">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              咨询热线：{hotline}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 相关新闻 -->
    {otherNews.length > 0 && (
      <section class="py-14 md:py-16 bg-surface-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-lg md:text-xl font-bold text-surface-800 mb-6">相关阅读</h2>
          <div class="grid md:grid-cols-3 gap-4 md:gap-6">
            {otherNews.map((post) => (
              <a href={`/news/${post.id}`} class="block group">
                <article class="bg-white rounded-xl p-5 border border-surface-100 hover:border-brand-200 hover:shadow-sm transition-all">
                  <h3 class="font-semibold text-surface-800 text-sm group-hover:text-brand-600 transition-colors line-clamp-2 mb-2">
                    {post.data.title}
                  </h3>
                  <time class="text-xs text-surface-400">
                    {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </article>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>
