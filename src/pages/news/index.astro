---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const companyNews = sortedNews.filter(n => n.id.startsWith('company/'));
const industryNews = sortedNews.filter(n => n.id.startsWith('industry/'));
---

<Layout title="新闻动态 — 新大物流">
  <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 text-center">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">新闻动态</h1>
      <p class="text-white/70 text-sm md:text-lg">了解新大物流最新动态与行业资讯</p>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 公司新闻 -->
      {companyNews.length > 0 && (
        <>
          <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-6 flex items-center gap-3">
            <span class="w-1 h-6 bg-brand-600 rounded-full"></span>
            公司新闻
          </h2>
          <div class="space-y-5 mb-12">
            {companyNews.map((post) => (
              <a href={`/news/${post.id}`} class="block group">
                <article class="p-5 md:p-6 rounded-xl border border-surface-200 hover:border-brand-200 hover:shadow-md transition-all">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-surface-800 group-hover:text-brand-600 transition-colors text-base md:text-lg mb-2">
                        {post.data.title}
                      </h3>
                      {post.data.description && (
                        <p class="text-sm text-surface-500 line-clamp-2">{post.data.description}</p>
                      )}
                    </div>
                    <svg class="w-5 h-5 text-surface-300 group-hover:text-brand-600 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </div>
                  <div class="flex items-center gap-3 mt-3 text-xs text-surface-400">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <span class="px-2 py-0.5 rounded-full bg-surface-100 text-surface-500">
                        {post.data.tags[0]}
                      </span>
                    )}
                  </div>
                </article>
              </a>
            ))}
          </div>
        </>
      )}

      <!-- 行业资讯 -->
      {industryNews.length > 0 && (
        <>
          <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-6 flex items-center gap-3">
            <span class="w-1 h-6 bg-brand-600 rounded-full"></span>
            行业资讯
          </h2>
          <div class="space-y-5">
            {industryNews.map((post) => (
              <a href={`/news/${post.id}`} class="block group">
                <article class="p-5 md:p-6 rounded-xl border border-surface-200 hover:border-brand-200 hover:shadow-md transition-all">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-surface-800 group-hover:text-brand-600 transition-colors text-base md:text-lg mb-2">
                        {post.data.title}
                      </h3>
                      {post.data.description && (
                        <p class="text-sm text-surface-500 line-clamp-2">{post.data.description}</p>
                      )}
                    </div>
                    <svg class="w-5 h-5 text-surface-300 group-hover:text-brand-600 shrink-0 mt-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </div>
                  <div class="flex items-center gap-3 mt-3 text-xs text-surface-400">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <span class="px-2 py-0.5 rounded-full bg-surface-100 text-surface-500">
                        {post.data.tags[0]}
                      </span>
                    )}
                  </div>
                </article>
              </a>
            ))}
          </div>
        </>
      )}

      {sortedNews.length === 0 && (
        <div class="text-center py-16 text-surface-400">
          <p>暂无新闻内容</p>
        </div>
      )}
    </div>
  </section>
</Layout>
