---
import Layout from '../../layouts/Layout.astro';
import { LINES, type LineInfo } from '../../consts/lines';
import { COMPANY } from '../../consts/company';

export function getStaticPaths() {
  return LINES.map((line) => ({ params: { slug: line.slug }, props: { line } }));
}

const { line } = Astro.props as { line: LineInfo };
const otherLines = LINES.filter((l) => l.slug !== line.slug);
const canonicalPath = `https://www.xinda56.cn/lines/${line.slug}/`;
---

<Layout title={`${line.title}_当天发货次日达 - 新大物流`} description={line.seoDesc}>
  <!-- 结构化数据：Service + FAQPage + BreadcrumbList -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify([{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": line.title,
    "url": canonicalPath,
    "provider": {
      "@type": "LocalBusiness",
      "name": COMPANY.fullName,
      "telephone": COMPANY.hotline,
      "url": "https://www.xinda56.cn"
    },
    "serviceType": "物流专线运输",
    "areaServed": line.areaServed,
    "description": line.seoDesc
  }, {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": line.faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }, {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://www.xinda56.cn" },
      { "@type": "ListItem", "position": 2, "name": "服务范围", "item": "https://www.xinda56.cn/services" },
      { "@type": "ListItem", "position": 3, "name": line.title, "item": canonicalPath }
    ]
  }])}>
  </script>

  <!-- Hero：结论前置 -->
  <section class="relative pt-20 md:pt-24 pb-12 md:pb-16 bg-brand-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-6">{line.title}</h1>
      <ul class="space-y-2.5">
        {line.conclusion.map((c) => (
          <li class="flex items-start gap-3 text-white/85 text-sm md:text-base">
            <svg class="w-5 h-5 text-brand-200 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            {c}
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-7 py-3 bg-white text-brand-700 font-bold rounded-xl hover:bg-surface-50 transition-all">
          询价 {COMPANY.hotline}
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-7 py-3 border border-white/30 text-white rounded-xl hover:bg-white/10 transition-all">
          在线留言
        </a>
      </div>
    </div>
    {line.image && (
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <img src={line.image} alt="新大物流{line.title}直营网点实拍" loading="eager" class="w-full max-w-md md:max-w-lg mx-auto rounded-xl border border-white/15 shadow-lg" />
      </div>
    )}
  </section>

  <!-- 线路基本信息 -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl md:text-3xl font-bold text-surface-800 mb-6">线路基本信息</h2>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-sm md:text-base">
          <tbody class="divide-y divide-surface-200">
            {line.facts.map((f) => (
              <tr>
                <td class="px-5 py-3.5 bg-surface-50 font-semibold text-surface-700 whitespace-nowrap w-36 md:w-48">{f.label}</td>
                <td class="px-5 py-3.5 text-surface-600">{f.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 起终点网点 -->
  <section class="py-12 md:py-16 bg-surface-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl md:text-3xl font-bold text-surface-800 mb-6">发货与提货网点</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-bold text-brand-700 mb-3">发货端 · {line.origin}</h3>
          <div class="space-y-3">
            {line.fromBranches.map((b) => (
              <div class="bg-white rounded-xl p-4 border border-surface-100">
                <p class="font-semibold text-surface-800 text-sm mb-1">{b.name}</p>
                <p class="text-surface-500 text-xs md:text-sm mb-1">{b.address}</p>
                <a href={`tel:${b.phone}`} class="text-brand-600 text-xs md:text-sm font-semibold">{b.phone}</a>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h3 class="font-bold text-brand-700 mb-3">到达端 · {line.dest}</h3>
          <div class="space-y-3">
            {line.toBranches.map((b) => (
              <div class="bg-white rounded-xl p-4 border border-surface-100">
                <p class="font-semibold text-surface-800 text-sm mb-1">{b.name}</p>
                <p class="text-surface-500 text-xs md:text-sm mb-1">{b.address}</p>
                <a href={`tel:${b.phone}`} class="text-brand-600 text-xs md:text-sm font-semibold">{b.phone}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务内容 -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl md:text-3xl font-bold text-surface-800 mb-8">这条线路能做什么</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {line.services.map((s) => (
          <div class="rounded-xl border border-surface-200 p-6">
            <h3 class="font-bold text-surface-800 text-lg mb-1">{s.title}</h3>
            <p class="text-surface-500 text-sm mb-4">{s.desc}</p>
            <ul class="space-y-2">
              {s.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-surface-600">
                  <svg class="w-4 h-4 text-brand-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 常见问题（页面可见，与 FAQPage 结构化一致） -->
  <section class="py-12 md:py-16 bg-surface-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl md:text-3xl font-bold text-surface-800 mb-8">常见问题</h2>
      <div class="space-y-5">
        {line.faqs.map((f) => (
          <div class="bg-white rounded-xl p-5 md:p-6 border border-surface-100">
            <h3 class="font-bold text-surface-800 mb-2">{f.q}</h3>
            <p class="text-surface-600 text-sm md:text-base leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 其他线路内链 -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl md:text-2xl font-bold text-surface-800 mb-6">其他专线</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {otherLines.map((l) => (
          <a href={`/lines/${l.slug}/`} class="block rounded-xl border border-surface-200 p-5 hover:border-brand-300 hover:shadow-sm transition-all">
            <p class="font-semibold text-surface-800">{l.title}</p>
            <p class="text-xs text-surface-400 mt-1">当天发货 · 次日到达</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-brand-600">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-xl md:text-3xl font-bold text-white mb-3">{line.title}，现在询价今天发</h2>
      <p class="text-white/80 text-sm md:text-base mb-7">报出货物名称、体积或重量，即可获取当日报价</p>
      <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white text-brand-600 font-bold text-base md:text-lg rounded-xl hover:bg-surface-50 transition-all shadow-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {COMPANY.hotline}
      </a>
    </div>
  </section>
</Layout>
