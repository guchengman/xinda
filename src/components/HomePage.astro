---
import { COMPANY, ADVANTAGES, STATS, SERVICES } from '../consts/company';
---

<!-- Hero 区域 -->
<section class="relative min-h-[70vh] md:min-h-screen flex items-center bg-brand-900 overflow-hidden">
  <!-- 背景装饰 -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 to-brand-900"></div>
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <!-- 内容 -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32 w-full">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 text-white/80 text-xs md:text-sm mb-6 backdrop-blur-sm border border-white/10">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
        赣州↔广东专线 · 天天发车
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight mb-4">
        {COMPANY.name}
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-white/90 font-semibold mb-2" style="font-family: 'Noto Sans SC', serif;">
        "{COMPANY.slogan}"
      </p>
      <p class="text-base md:text-xl text-white/70 mb-8 md:mb-10">
        {COMPANY.desc}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-brand-600 text-white font-bold text-base md:text-lg rounded-xl hover:bg-brand-700 transition-all shadow-lg shadow-brand-600/30 active:scale-[0.98]">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          立即询价
        </a>
        <a href="/services" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white/10 text-white font-semibold text-base md:text-lg rounded-xl border border-white/20 hover:bg-white/20 transition-all backdrop-blur-sm active:scale-[0.98]">
          了解更多
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- 滚动指示器 -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden md:block">
    <div class="w-6 h-10 rounded-full border-2 border-white/20 flex items-start justify-center p-1.5">
      <div class="w-1.5 h-3 rounded-full bg-white/60 animate-bounce"></div>
    </div>
  </div>
</section>

<!-- 核心数据 -->
<section class="py-10 md:py-14 bg-white border-b border-surface-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {STATS.map((stat) => (
        <div class="text-center animate-fade-in-up">
          <div class="text-3xl md:text-5xl font-bold text-brand-600 mb-1">
            {stat.value}
            <span class="text-lg md:text-2xl text-surface-400">{stat.suffix}</span>
          </div>
          <div class="text-sm md:text-base text-surface-500 font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 核心优势 -->
<section class="py-14 md:py-20 bg-surface-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">为什么选择新大物流？</h2>
      <p class="text-surface-500 max-w-2xl mx-auto text-sm md:text-base">十五载赣粤专线深耕，以实力和服务赢得客户信赖</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {ADVANTAGES.map((item, i) => (
        <div class="group bg-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all border border-surface-100 hover:border-brand-200">
          <div class="w-12 h-12 rounded-xl bg-brand-50 flex items-center justify-center mb-5 group-hover:bg-brand-600 transition-colors">
            {i === 0 && <svg class="w-6 h-6 text-brand-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>}
            {i === 1 && <svg class="w-6 h-6 text-brand-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
            {i === 2 && <svg class="w-6 h-6 text-brand-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
            {i === 3 && <svg class="w-6 h-6 text-brand-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
          </div>
          <h3 class="text-lg font-semibold text-surface-800 mb-2">{item.title}</h3>
          <p class="text-sm text-surface-500 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 服务概览 -->
<section class="py-14 md:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">服务范围</h2>
      <p class="text-surface-500 max-w-2xl mx-auto text-sm md:text-base">全方位物流服务，满足您的多样化需求</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {SERVICES.map((service) => (
        <div class="group rounded-2xl border border-surface-200 overflow-hidden hover:shadow-lg transition-all">
          <div class="h-2 bg-brand-600"></div>
          <div class="p-6 md:p-8">
            <h3 class="text-xl font-bold text-surface-800 mb-3">{service.title}</h3>
            <p class="text-sm text-surface-500 mb-4">{service.desc}</p>
            <ul class="space-y-2.5">
              {service.details.map((detail) => (
                <li class="flex items-start gap-2.5 text-sm text-surface-600">
                  <svg class="w-4 h-4 text-brand-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  {detail}
                </li>
              ))}
            </ul>
            <a href="/services" class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors group/link">
              了解详情
              <svg class="w-4 h-4 group-hover/link:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 服务流程 -->
<section class="py-14 md:py-20 bg-surface-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-4xl font-bold text-surface-800 mb-4">服务流程</h2>
      <p class="text-surface-500 text-sm md:text-base">标准化的操作流程，确保货物安全准时送达</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 md:gap-6">
      {[
        { step: '01', title: '客户委托', desc: '1小时内上门取货' },
        { step: '02', title: '专业包装', desc: '安全加固' },
        { step: '03', title: '当天发车', desc: '准时起运' },
        { step: '04', title: '在途跟踪', desc: '全程信息反馈' },
        { step: '05', title: '到货通知', desc: '准时派送上门' },
      ].map((item) => (
        <div class="relative text-center">
          <div class="hidden md:block absolute top-8 left-[60%] w-[80%] h-0.5 border-t-2 border-dashed border-brand-200"></div>
          <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-brand-600 text-white flex items-center justify-center text-lg md:text-xl font-bold mx-auto mb-3 relative z-10">
            {item.step}
          </div>
          <h3 class="font-semibold text-surface-800 text-sm md:text-base mb-1">{item.title}</h3>
          <p class="text-xs md:text-sm text-surface-500">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 信任与CTA -->
<section class="py-14 md:py-20 bg-brand-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl md:text-4xl font-bold text-white mb-4">立即联系我们</h2>
    <p class="text-white/80 text-sm md:text-lg mb-8 max-w-2xl mx-auto">
      无论您需要整车运输、零担配送还是仓储服务，新大物流都能为您提供最专业的物流解决方案
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white text-brand-600 font-bold text-base md:text-lg rounded-xl hover:bg-surface-50 transition-all shadow-lg active:scale-[0.98]">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {COMPANY.hotline}
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3.5 md:px-10 md:py-4 bg-white/10 text-white font-semibold text-base md:text-lg rounded-xl border border-white/30 hover:bg-white/20 transition-all active:scale-[0.98]">
        在线留言询价
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>
