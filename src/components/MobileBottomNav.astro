---
import { COMPANY } from '../consts/company';
---

<!-- 移动端底部固定导航 -->
<nav class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-surface-200 md:hidden safe-area-bottom" aria-label="移动端底部导航">
  <div class="flex items-center justify-around h-16 px-2">
    <a href="/" class="flex flex-col items-center justify-center gap-0.5 min-w-0 flex-1 py-1">
      <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span class="text-[10px] font-medium text-brand-600">首页</span>
    </a>
    <a href="/services" class="flex flex-col items-center justify-center gap-0.5 min-w-0 flex-1 py-1">
      <svg class="w-5 h-5 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
      <span class="text-[10px] font-medium text-surface-500">服务</span>
    </a>

    <!-- 突出的一键拨打按钮 -->
    <a href={`tel:${COMPANY.hotline}`} class="flex flex-col items-center justify-center -mt-4">
      <div class="w-14 h-14 rounded-full bg-brand-600 flex items-center justify-center shadow-lg shadow-brand-600/30 hover:bg-brand-700 transition-colors active:scale-95">
        <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      </div>
      <span class="text-[10px] font-semibold text-brand-600 mt-0.5">立即拨打</span>
    </a>

    <a href="/news" class="flex flex-col items-center justify-center gap-0.5 min-w-0 flex-1 py-1">
      <svg class="w-5 h-5 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      <span class="text-[10px] font-medium text-surface-500">动态</span>
    </a>
    <a href="/contact" class="flex flex-col items-center justify-center gap-0.5 min-w-0 flex-1 py-1">
      <svg class="w-5 h-5 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <span class="text-[10px] font-medium text-surface-500">联系</span>
    </a>
  </div>
</nav>
