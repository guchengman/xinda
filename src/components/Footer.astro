---
import { COMPANY, BRANCHES } from '../consts/company';
---

<footer class="bg-brand-900 text-surface-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- 公司信息 -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="w-9 h-9 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold text-sm">新</div>
          <div>
            <span class="text-white font-bold text-base">{COMPANY.name}</span>
          </div>
        </a>
        <p class="text-sm text-surface-400 leading-relaxed mb-4">
          专业从事赣州至广东往返专线运输，自有车队，天天发车。以"踏踏实实做人，认认真真做事"为宗旨，为客户提供安全、快捷、可靠的物流服务。
        </p>
        <div class="flex items-center gap-4">
          <a href={`tel:${COMPANY.hotline}`} class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 text-white text-sm font-semibold rounded-lg hover:bg-brand-700 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {COMPANY.hotline}
          </a>
        </div>
      </div>

      <!-- 快捷链接 -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">快捷导航</h3>
        <ul class="space-y-2.5">
          {[
            { label: '首页', href: '/' },
            { label: '关于我们', href: '/about' },
            { label: '服务范围', href: '/services' },
            { label: '新闻动态', href: '/news' },
            { label: '联系我们', href: '/contact' },
          ].map((item) => (
            <li>
              <a href={item.href} class="text-sm text-surface-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 服务项目 -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">服务项目</h3>
        <ul class="space-y-2.5">
          {[
            { label: '整车运输', href: '/services' },
            { label: '零担配送', href: '/services' },
            { label: '仓储服务', href: '/services' },
            { label: '上门取货', href: '/services' },
            { label: '货物保险', href: '/services' },
          ].map((item) => (
            <li>
              <a href={item.href} class="text-sm text-surface-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 联系方式 -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">联系我们</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <span class="block text-surface-500 text-xs">全国服务热线</span>
            <a href={`tel:${COMPANY.hotline}`} class="text-brand-400 font-semibold hover:text-brand-300 transition-colors">{COMPANY.hotline}</a>
          </li>
          <li>
            <span class="block text-surface-500 text-xs">企业邮箱</span>
            <span>{COMPANY.email}</span>
          </li>
          <li>
            <span class="block text-surface-500 text-xs">总部地址</span>
            <span class="text-surface-300">{COMPANY.headquarters}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="mt-12 pt-8 border-t border-brand-800 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-surface-500">
      <p>&copy; {new Date().getFullYear()} {COMPANY.fullName}. All rights reserved.</p>
      <p>{COMPANY.icp}</p>
    </div>
  </div>
</footer>
